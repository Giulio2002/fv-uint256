import Extracted
import Fv256.Util
import Janus

open Janus.Arm64

namespace Fv256.Arm64.Log10

/-- address and size of the Go global `uint256.pows64` (`[20]uint64`, powers of ten): generated by `janus extract` from the binary's symbol table -/
abbrev P64 : Nat := Extracted.dataAddr.«github.com/holiman/uint256.pows64»
abbrev P64sz : Nat := Extracted.dataSize.«github.com/holiman/uint256.pows64»
/-- address and size of the Go global `uint256.pows` (`[60]Int`, `10^(20+i)`) -/
abbrev PB : Nat := Extracted.dataAddr.«github.com/holiman/uint256.pows»
abbrev PBsz : Nat := Extracted.dataSize.«github.com/holiman/uint256.pows»

/-- The Go global `pows64` at its address in the binary: readable and holding `10^i`. -/
def Tabs64 (m : Memory) : Prop :=
  m.accessible P64 P64sz false = true ∧ ∀ i, i < 20 → m.readLE (P64 + 8 * i) 8 = 10 ^ i

/-- The Go global `pows` (`[60]Int`, `10^(20+i)` as four little-endian limbs; only `i < 58`, i.e. up to `10^77 < 2^256`, is claimed and ever read: the last two Go entries overflow 256 bits). -/
def TabsBig (m : Memory) : Prop :=
  m.accessible PB PBsz false = true ∧ ∀ i, i < 58 → m.readLE (PB + 32 * i) 32 = 10 ^ (20 + i)

end Fv256.Arm64.Log10
