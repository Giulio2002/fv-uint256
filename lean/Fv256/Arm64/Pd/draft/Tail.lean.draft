-- DRAFT (uncompiled): mechanical amd64->arm64 port of Amd64/Pd/Tail.lean. Register map rax,rcx,rdx,rbx,rsi,rdi,r9,r11,r12,r13,r14 -> x0,x2,x8,x1,x4,x3,x6,x9,x10,x11,x28.
-- Offsets shifted +16 (arm64 body sp = entry sp - 400). TODO by hand: pdE offsets (pdH=+0xfc, pdI=+0x190, pdJ=+0x1cc, pdK=+0x1f8, pdF=+0x234), GuardOK/StackOK, ret via x30, saved x29/x30 slots, branch hbr forms.
import Fv256.Arm64.PrettyProg
import Fv256.SpecE
import Fv256.UtilE
import Fv256.PdCells
import Fv256.Arm64.P.T
import Fv256.Util
import Fv256.UtilB2
import Fv256.Arm64.Pd.Pad
import Fv256.Arm64.Pd.Inner

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic
open Fv256.E Fv256.Amd64.P

namespace Fv256.Arm64.Pd

theorem or4_iff_wv (M : Memory) (p y : Nat) (hy : Fv256.B.wv M p 4 = y) :
    (BitVec.ofNat 80 (M.readLE (p + 8) 8) ||| BitVec.ofNat 80 (M.readLE p 8) ||| BitVec.ofNat 80 (M.readLE (p + 16) 8) |||
      BitVec.ofNat 80 (M.readLE (p + 24) 8)).toNat = 0 ↔ y = 0 := by
  have l0 := Janus.Arm64.Memory.readLE_lt M p 8
  have l1 := Janus.Arm64.Memory.readLE_lt M (p + 8) 8
  have l2 := Janus.Arm64.Memory.readLE_lt M (p + 16) 8
  have l3 := Janus.Arm64.Memory.readLE_lt M (p + 24) 8
  simp only [Nat.reducePow] at l0 l1 l2 l3
  rw [Fv256.E.or4_toNat_zero_iff _ _ _ _ l1 l0 l2 l3]
  simp only [Fv256.B.wv, Nat.add_assoc, Nat.reduceAdd, Nat.mul_zero, Nat.add_zero] at hy
  omega

set_option maxHeartbeats 8000000 in
set_option maxRecDepth 200000 in
/-- After the inner loop with a zero quotient: the jump to the final call. -/
theorem pd_tail_z (s : State) (b : Nat) (hpc : s.pc = BitVec.ofNat 80 pdJ)
    (e4 : s.regs SP = BitVec.ofNat 80 b) (hb : 0x190 ≤ b) (hb2 : b + 0x1a8 ≤ 2 ^ 48)
    (hacc : s.mem.accessible (b + 0x140) 32 false = true) (hy : Fv256.B.wv s.mem (b + 0x140) 4 = 0) :
    ReachesRet Fv256.Arm64.PrettyProg.program (BitVec.ofNat 80 pdF) s
      (fun S' => (∀ k, k ∉ [2, 15] → S'.regs k = s.regs k) ∧ S'.mem = s.mem ∧ S'.xmm = s.xmm ∧ S'.df = s.df) := by
  have hc1 : pdE + 0x5000 < 2 ^ 47 := by decide
  have hz := (or4_iff_wv s.mem (b + 0x140) 0 hy).2 rfl
  have hz' : (BitVec.ofNat 80 (s.mem.readLE (b + 344) 8) ||| BitVec.ofNat 80 (s.mem.readLE (b + 352) 8) |||
      BitVec.ofNat 80 (s.mem.readLE (b + 352) 8) ||| BitVec.ofNat 80 (s.mem.readLE (b + 344) 8)).toNat = 0 := hz
  janus_run [e4, hz'] until [pdF]
  refine ReachesRet.done (by rfl) ⟨?_, ?_, ?_, ?_⟩
  · intro k hk
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hk
    simp [setReg, hk]
  · rfl
  · rfl
  · rfl

set_option maxHeartbeats 8000000 in
set_option maxRecDepth 200000 in
/-- After the inner loop with a non-zero quotient: to the pad loop head with `rdx = 0`. -/
theorem pd_tail_nz (s : State) (b y' : Nat) (hpc : s.pc = BitVec.ofNat 80 pdJ)
    (e4 : s.regs SP = BitVec.ofNat 80 b) (hb : 0x190 ≤ b) (hb2 : b + 0x1a8 ≤ 2 ^ 48)
    (hacc : s.mem.accessible (b + 0x140) 32 false = true) (hy : Fv256.B.wv s.mem (b + 0x140) 4 = y') (hy0 : y' ≠ 0) :
    ReachesRet Fv256.Arm64.PrettyProg.program (BitVec.ofNat 80 pdK) s
      (fun S' => S'.regs 8 = 0#80 ∧ (∀ k, k ∉ [2, 15] → S'.regs k = s.regs k) ∧ S'.mem = s.mem ∧ S'.xmm = s.xmm ∧ S'.df = s.df) := by
  have hc1 : pdE + 0x5000 < 2 ^ 47 := by decide
  have hz := or4_iff_wv s.mem (b + 0x140) y' hy
  have hz' : ¬ (BitVec.ofNat 80 (s.mem.readLE (b + 344) 8) ||| BitVec.ofNat 80 (s.mem.readLE (b + 352) 8) |||
      BitVec.ofNat 80 (s.mem.readLE (b + 352) 8) ||| BitVec.ofNat 80 (s.mem.readLE (b + 344) 8)).toNat = 0 := fun h => hy0 (hz.1 h)
  janus_run [e4, hz'] until [pdK]
  refine ReachesRet.done (by rfl) ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [setReg]
  · intro k hk
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hk
    simp [setReg, hk]
  · rfl
  · rfl
  · rfl
end Fv256.Arm64.Pd
