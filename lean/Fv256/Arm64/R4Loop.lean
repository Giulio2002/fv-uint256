import Fv256.Arm64.R4Nat
namespace Fv256.Arm64.R4Nat
theorem dt (p : Prop) [Decidable p] : (decide p).toNat = if p then 1 else 0 := by by_cases h : p <;> simp [h]

/-- one loop test `r - m` (five limbs `c`, four limbs `n`, top limb of `m` is 0): flag and limbs -/
theorem loop_sub (c0 c1 c2 c3 c4 n0 n1 n2 n3 x310r10 x310r11 x310r13 x310r14 x310r5 x310r15 : Nat)
    (b0 : c0 < 2 ^ 64) (b1 : c1 < 2 ^ 64) (b2 : c2 < 2 ^ 64) (b3 : c3 < 2 ^ 64) (b4 : c4 < 2 ^ 64)
    (d0 : n0 < 2 ^ 64) (d1 : n1 < 2 ^ 64) (d2 : n2 < 2 ^ 64) (d3 : n3 < 2 ^ 64)
    (h_x310r10 : x310r10 = (18446744073709551616 - n0 + c0) % 18446744073709551616) (h_x310r11 : x310r11 = (c1 + (18446744073709551616 - 1 - n1) + (decide (n0 ≤ c0)).toNat) % 18446744073709551616) (h_x310r13 : x310r13 = (c2 + (18446744073709551616 - 1 - n2) + (c1 + (18446744073709551616 - 1 - n1) + (decide (n0 ≤ c0)).toNat) / 18446744073709551616) % 18446744073709551616) (h_x310r14 : x310r14 = (c3 + (18446744073709551616 - 1 - n3) + (c2 + (18446744073709551616 - 1 - n2) + (c1 + (18446744073709551616 - 1 - n1) + (decide (n0 ≤ c0)).toNat) / 18446744073709551616) / 18446744073709551616) % 18446744073709551616) (h_x310r5 : x310r5 = (c4 + (18446744073709551616 - 1 - 0) + (c3 + (18446744073709551616 - 1 - n3) + (c2 + (18446744073709551616 - 1 - n2) + (c1 + (18446744073709551616 - 1 - n1) + (decide (n0 ≤ c0)).toNat) / 18446744073709551616) / 18446744073709551616) / 18446744073709551616) % 18446744073709551616) (h_x310r15 : x310r15 = (18446744073709551616 - (18446744073709551615 + (c4 + (18446744073709551616 - 1 - 0) + (c3 + (18446744073709551616 - 1 - n3) + (c2 + (18446744073709551616 - 1 - n2) + (c1 + (18446744073709551616 - 1 - n1) + (decide (n0 ≤ c0)).toNat) / 18446744073709551616) / 18446744073709551616) / 18446744073709551616) / 18446744073709551616) % 18446744073709551616) % 18446744073709551616) :
    (x310r15 = 0 ↔ n0 + 2 ^ 64 * n1 + 2 ^ 128 * n2 + 2 ^ 192 * n3 ≤ c0 + 2 ^ 64 * c1 + 2 ^ 128 * c2 + 2 ^ 192 * c3 + 2 ^ 256 * c4) ∧
    (x310r15 = 0 → x310r10 + 2 ^ 64 * x310r11 + 2 ^ 128 * x310r13 + 2 ^ 192 * x310r14 + 2 ^ 256 * x310r5 + (n0 + 2 ^ 64 * n1 + 2 ^ 128 * n2 + 2 ^ 192 * n3) =
      c0 + 2 ^ 64 * c1 + 2 ^ 128 * c2 + 2 ^ 192 * c3 + 2 ^ 256 * c4) := by
  subst h_x310r10 h_x310r11 h_x310r13 h_x310r14 h_x310r5 h_x310r15
  simp only [dt]
  iterate 6 (all_goals (try split))
  all_goals omega

theorem back_lt (R N n R' : Nat) (h : R < (n + 1) * N + N) (hs : R' + N = R) : R' < n * N + N := by
  rw [Nat.add_mul, Nat.one_mul] at h
  omega

theorem zero_false (R N : Nat) (h : R < 0 * N + N) (hn : N ≤ R) : False := by omega

theorem exit_nat (c0 c1 c2 c3 c4 N : Nat) (b0 : c0 < 2 ^ 64) (b1 : c1 < 2 ^ 64) (b2 : c2 < 2 ^ 64) (b3 : c3 < 2 ^ 64)
    (hN : N < 2 ^ 256) (h : c0 + 2 ^ 64 * c1 + 2 ^ 128 * c2 + 2 ^ 192 * c3 + 2 ^ 256 * c4 < N) :
    c4 = 0 ∧ (c0 + 2 ^ 64 * c1 + 2 ^ 128 * c2 + 2 ^ 192 * c3) % N = c0 + 2 ^ 64 * c1 + 2 ^ 128 * c2 + 2 ^ 192 * c3 := by
  have h4 : c4 = 0 := by omega
  subst h4
  exact ⟨rfl, Nat.mod_eq_of_lt (by omega)⟩

theorem bound_N (m0 m1 m2 m3 : Nat) (b0 : m0 < 2 ^ 64) (b1 : m1 < 2 ^ 64) (b2 : m2 < 2 ^ 64) (b3 : m3 < 2 ^ 64) :
    m0 + 2 ^ 64 * m1 + 2 ^ 128 * m2 + 2 ^ 192 * m3 < 2 ^ 256 := by omega

end Fv256.Arm64.R4Nat
