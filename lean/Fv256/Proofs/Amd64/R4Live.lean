theorem ofNat_mod64 (e : Nat) : BitVec.ofNat 64 (e % 18446744073709551616) = BitVec.ofNat 64 e := by
  apply BitVec.eq_of_toNat_eq; simp only [BitVec.toNat_ofNat, Nat.mod_mod]

theorem zero_sub64 (b : Nat) : (0#64 : BitVec 64) - BitVec.ofNat 64 b = BitVec.ofNat 64 ((18446744073709551616 - b % 18446744073709551616) % 18446744073709551616) := by
  apply BitVec.eq_of_toNat_eq; simp only [BitVec.toNat_sub, BitVec.toNat_ofNat]; omega

theorem subFlags_fst_ofNat (w a b : Nat) (c : Bool) : (subFlags (BitVec.ofNat w a) (BitVec.ofNat w b) c).fst =
    BitVec.ofNat w ((a % 2 ^ w + 2 ^ w - b % 2 ^ w - c.toNat) % 2 ^ w) := by
  apply BitVec.eq_of_toNat_eq; rw [subFlags_fst_toNat_ofNat]; simp only [BitVec.toNat_ofNat, Nat.mod_mod]

