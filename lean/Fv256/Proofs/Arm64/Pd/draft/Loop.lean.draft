-- DRAFT (uncompiled): mechanical amd64->arm64 port of Amd64/Pd/Loop.lean. Register map rax,rcx,rdx,rbx,rsi,rdi,r9,r11,r12,r13,r14 -> x0,x2,x8,x1,x4,x3,x6,x9,x10,x11,x28.
-- Offsets shifted +16 (arm64 body sp = entry sp - 400). TODO by hand: pdE offsets (pdH=+0xfc, pdI=+0x190, pdJ=+0x1cc, pdK=+0x1f8, pdF=+0x234), GuardOK/StackOK, ret via x30, saved x29/x30 slots, branch hbr forms.
import Fv256.Arm64.PrettyProg
import Fv256.SpecE
import Fv256.UtilE
import Fv256.PdCells
import Fv256.Arm64.P.T
import Fv256.Util
import Fv256.UtilB2
import Fv256.Arm64.Pd.Chunk

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic
open Fv256.E Fv256.Amd64.P

namespace Fv256.Arm64.Pd

theorem z_small (z : Nat) (hz : z < 2 ^ 256) : z / 10 ^ (19 * 4 + 19) = 0 := by
  apply Nat.div_eq_of_lt
  have : (2:Nat) ^ 256 < 10 ^ (19 * 4 + 19) := by decide
  omega

set_option maxHeartbeats 32000000 in
set_option maxRecDepth 200000 in
/-- The whole loop of `PrettyDec`, from the head with `t` chunks done to `pdF`. -/
theorem pd_loop (b z sepb : Nat) (hz1 : z < 2 ^ 256) (hsb : sepb < 256)
    (hb : 0x190 ≤ b) (hb8 : b % 8 = 0) (hb2 : b + 0x1a8 ≤ 2 ^ 48) :
    ∀ n t, t + n = 4 → ∀ (s : State), s.pc = BitVec.ofNat 80 pdH →
    z / 10 ^ (19 * t) ≠ 0 →
    s.mem.accessible (b - 0x190) (0x190 + 0x1a8) true = true → TabsOK s.mem →
    s.xmm 15 = 0 → s.df = false →
    s.regs 0 = BitVec.ofNat 80 19 → s.regs 2 = BitVec.ofNat 80 (132 - cOf (19 * t)) → s.regs 8 = BitVec.ofNat 80 (b + 0x50) →
    s.regs 4 = BitVec.ofNat 80 (cOf (19 * t) % 4) → s.regs 3 = BitVec.ofNat 80 (b + 0x140) → s.regs 6 = BitVec.ofNat 80 (b + 0x160) →
    s.regs SP = BitVec.ofNat 80 b → s.regs 29 = BitVec.ofNat 80 (b + 0x188) →
    s.mem.readLE ((s.regs 28).toNat + 16) 8 + 0x100 < b → (s.regs 28).toNat + 24 ≤ 2 ^ 48 →
    s.mem.accessible ((s.regs 28).toNat + 16) 8 false = true →
    ((s.regs 28).toNat + 16 + 8 ≤ b - 0x190 ∨ b + 0x1a8 ≤ (s.regs 28).toNat + 16) →
    Fv256.B.wv s.mem (b + 0x140) 4 = z / 10 ^ (19 * t) → Fv256.B.wv s.mem (b + 0x160) 4 = 10 ^ 19 →
    s.mem.readLE (b + 0x1a0) 1 = sepb → OutIs s.mem (b + 231) sepb z (cOf (19 * t)) →
    ReachesRet Fv256.Arm64.PrettyProg.program (BitVec.ofNat 80 pdF) s
      (fun S' => S'.regs 10 = BitVec.ofNat 80 (132 - plen z) ∧
        S'.regs SP = BitVec.ofNat 80 b ∧ S'.regs 29 = BitVec.ofNat 80 (b + 0x188) ∧ S'.regs 28 = s.regs 28 ∧
        S'.xmm 15 = 0 ∧ S'.df = false ∧
        MemFrame s.mem S'.mem [(b - 0x190, b + 392)] ∧ OutIs S'.mem (b + 231) sepb z (plen z) ∧ TabsOK S'.mem) := by
  intro n
  induction n with
  | zero =>
    intro t ht s hpc hy0 hw hd hx15 hdf e0 e1 e2 e6 e7 e9 e4 e5 hg3 hg1 hg2 hgd hym hdm hsep hout
    have ht4 : t = 4 := by omega
    subst ht4
    exact pd_chunk_final s b z (19 * 4) sepb s.mem hpc rfl hy0 (z_small z hz1) hz1 (by omega) hsb hb hb8 hb2 hw hd hx15 hdf
      e0 e1 e2 e6 e7 e9 e4 e5 hg3 hg1 hg2 hgd hym hdm hsep hout
  | succ n ih =>
    intro t ht s hpc hy0 hw hd hx15 hdf e0 e1 e2 e6 e7 e9 e4 e5 hg3 hg1 hg2 hgd hym hdm hsep hout
    by_cases hy' : z / 10 ^ (19 * t + 19) = 0
    · exact pd_chunk_final s b z (19 * t) sepb s.mem hpc rfl hy0 hy' hz1 (by omega) hsb hb hb8 hb2 hw hd hx15 hdf
        e0 e1 e2 e6 e7 e9 e4 e5 hg3 hg1 hg2 hgd hym hdm hsep hout
    · refine Fv256.E.reachesRet_bind' (pd_chunk_next s b z (19 * t) sepb s.mem hpc rfl hy0 hy' hz1 (by omega) hsb hb hb8 hb2 hw hd hx15 hdf
        e0 e1 e2 e6 e7 e9 e4 e5 hg3 hg1 hg2 hgd hym hdm hsep hout) ?_
      intro S hrip ⟨r0, r1, r2, r6, r7, r9, r4, r5, r14, rx, rdf, ry, rd, rfr, rout, rtab⟩
      have e19 : 19 * (t + 1) = 19 * t + 19 := by omega
      have hy1 : z / 10 ^ (19 * (t + 1)) ≠ 0 := by rw [e19]; exact hy'
      refine ReachesRet.mono (ih (t + 1) (by omega) S hrip hy1 ?_ ?_ rx rdf ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_) ?_
      · rw [rfr.accessible]; exact hw
      · exact rtab
      · rw [r0]
      · rw [e19]; exact r1
      · exact r2
      · rw [e19]; exact r6
      · exact r7
      · exact r9
      · exact r4
      · exact r5
      · rw [r14, rfr.readLE _ _ (by simp only [Outside, and_true]; omega)]; exact hg3
      · rw [r14]; exact hg1
      · rw [r14, rfr.accessible]; exact hg2
      · rw [r14]; exact hgd
      · rw [e19]; exact ry
      · exact rd
      · rw [rfr.readLE _ _ (by simp only [Outside, and_true]; omega)]; exact hsep
      · rw [e19]; exact rout
      · rintro S2 ⟨q12, q4, q5, q14, qx, qdf, qfr, qout, qtab⟩
        refine ⟨q12, q4, q5, ?_, qx, qdf, ?_, qout, qtab⟩
        · rw [q14, r14]
        · exact rfr.trans qfr (fun a n h => ⟨h, h⟩)
end Fv256.Arm64.Pd
