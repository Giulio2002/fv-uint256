-- DRAFT (uncompiled): mechanical amd64->arm64 port of Amd64/Pd/Lift.lean. Register map rax,rcx,rdx,rbx,rsi,rdi,r9,r11,r12,r13,r14 -> x0,x2,x8,x1,x4,x3,x6,x9,x10,x11,x28.
-- Offsets shifted +16 (arm64 body sp = entry sp - 400). TODO by hand: pdE offsets (pdH=+0xfc, pdI=+0x190, pdJ=+0x1cc, pdK=+0x1f8, pdF=+0x234), GuardOK/StackOK, ret via x30, saved x29/x30 slots, branch hbr forms.
import Fv256.LinkEq
import Fv256.Arm64.Pd.Summary

/-!
# `pd_summary` for the consumer's extracted program

`pd_summary` is proved once over the library program `Fv256.Arm64.PrettyProg.program` (no `Extracted`); `pd_summary_E` moves it to
an extraction `E` that contains it (`LibIn`, checked by `decide` in the consumer).
-/

open Janus Janus.Amd64 Janus.Amd64.GoABI Janus.Amd64.Tactic Janus.Spec Janus.Contracts
open Fv256.E

namespace Fv256.Arm64.Pd

theorem pd_summary_E (st : Nat) {E : Janus.Amd64.Program} (hE : Fv256.LinkEq.LibIn Fv256.Arm64.PrettyProg.program E)
    (hss : E.contractAddr "runtime.slicebytetostring" = ssAddrL)
    (impl : List Amd64.Segment) (rt : List (Nat × Nat)) (H : RtReady) (z sep : BitVec 80)
    (hc : RtContract64 (E.link impl) (E.contractAddr "runtime.slicebytetostring") rt 4096 H (slicebytetostringSpec st)) :
    Summary (E.link impl) pdE
      (fun s => s.regs 0 = z ∧ s.regs 1 = sep ∧ StackGuardOK s 0x378 ∧ StackWritable s 4576 0x18 ∧
        E.DataLoaded s.mem ∧
        Outside (s.sp.toNat - 4576) (4576 + 0x18) rt ∧ s.sp.toNat % 8 = 0 ∧ Buffer s z 32 false ∧
        (z.toNat + 32 ≤ s.sp.toNat - 4576 ∨ s.sp.toNat + 0x18 ≤ z.toNat) ∧
        ((s.regs 28).toNat + 24 ≤ s.sp.toNat - 4576 ∨ s.sp.toNat + 0x18 ≤ (s.regs 28).toNat + 16) ∧
        (s.mem.readLE z.toNat 32 ≠ 0 →
          H [0, s.sp.toNat - 0xa8 - plen (s.mem.readLE z.toNat 32), plen (s.mem.readLE z.toNat 32)]
            (s.regs 28).toNat (s.sp.toNat - 0x188) (rtView rt s.mem)) ∧
        s.xmm 15 = 0 ∧ s.df = false ∧ s.mem.readLE s.sp.toNat 8 < 140737488355328)
      (fun s s' => StrOut s'.mem (s'.regs 0).toNat (s'.regs 1).toNat (prettyBytes (sep.toNat % 256) (valueAt s z 32)) ∧
        s'.regs SP = s.regs SP + 8 ∧ s'.regs 29 = s.regs 29 ∧ s'.regs 28 = s.regs 28 ∧ s'.xmm 15 = s.xmm 15 ∧
        MemFrame s.mem s'.mem (rt ++ [(s.sp.toNat - 4576, s.sp.toNat + 0x18)])) := by
  have hP := hE.progEq impl
  rw [hss] at hc
  have hc' := Fv256.LinkEq.Summary.of_progEq hP.symm hc
  have hsum := Fv256.LinkEq.Summary.of_progEq hP (pd_summary st _ rt H z sep hc')
  intro s hpc ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩
  exact hsum s hpc ⟨h0, h1, h2, h3, Fv256.LinkEq.DataLoaded.of_subset hE.data h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩

end Fv256.Arm64.Pd
