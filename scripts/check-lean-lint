#!/usr/bin/env python3
"""scripts/check-lean-lint -- LEAN-LEVEL IO / initializer lint (second layer after scripts/lint_source.py).

Elaborates (statements only, proofs replaced by `sorry`, see scripts/SvyTools.lean) the import closure of every final theorem module and
runs `#lint_io`: FAILS if any constant defined in an Fv256 module has a type mentioning IO/EIO/BaseIO, a value referencing an IO/system
primitive (resolved constants, so `open IO` is irrelevant), or is an @[init]/initialize/builtin_initialize declaration.
Theorem *bodies* (tactic blocks) are covered by lint_source.py's compile-time-command lint.
usage: scripts/check-lean-lint [--closure FILE] [FN ...]    env: as scripts/spec_survey.py
"""
import json, os, subprocess, sys
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
args = sys.argv[1:]; closure = None
if args[:1] == ['--closure']: closure = args[1]; args = args[2:]
if closure is None:
    closure = 'build/lean-lint.json'
    if subprocess.run([sys.executable, 'scripts/spec_survey.py', '--out', closure] + args).returncode != 0:
        sys.exit('check-lean-lint: FAIL: survey crashed')
sv = json.load(open(closure)); fail = 0; seen = set()
for k, v in sorted(sv.items()):
    if 'error' in v: print('FAIL: %s: %s' % (k, v['error'][:300])); fail = 1; continue
    for l in v.get('iolint', []):
        if l not in seen: seen.add(l); print('FAIL: %s: %s' % (k, l)); fail = 1
print('check-lean-lint: %d rows; %s' % (len(sv), 'FAILED' if fail else 'OK'))
sys.exit(fail)
