#!/usr/bin/env python3
"""scripts/check-spec-closure -- RELEASE CHECK: every final theorem STATEMENT depends only on lean/Fv256/Spec/ + Janus + Extracted.

For every theorem verify-all.sh verifies (`correctness` of each verified docs/COVERAGE.md row / Amd64v3 file, plus every existential witness
theorem) the Fv256 constants reachable from its TYPE, transitively through definitions (types and values, never theorem proofs), are
computed by Lean itself (scripts/spec_survey.py + scripts/SvyTools.lean: statements elaborated, proofs replaced by `sorry`).
FAILS (exit 1) if any such constant is defined outside module Fv256.Spec.* (i.e. outside lean/Fv256/Spec/), or if a Spec/ module
imports a Fv256.Proofs.* module, (a lemma reached from a definition value is fine only if it too lives in Spec/).

usage: scripts/check-spec-closure [--structure-only] [--closure FILE] [--index FILE.md] [FN ...]     (default: survey every row, ~10-40 min, one lean at a time)
env:   as scripts/spec_survey.py (SPEC_WS, JANUS, SPEC_JANUS_PKG, HEAVY=1, MEMCAP)
"""
import json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
args = sys.argv[1:]
closure = None
structure_only = False
index = None
while args and args[0].startswith('--'):
    if args[0] == '--closure': closure = args[1]; args = args[2:]
    elif args[0] == '--structure-only': structure_only = True; args = args[1:]
    elif args[0] == '--index': index = args[1]; args = args[2:]
    else: sys.exit('unknown option ' + args[0])
fail = 0
if not os.path.isdir('lean/Fv256/Spec') or not os.path.isdir('lean/Fv256/Proofs'):
    sys.exit('check-spec-closure: FAIL: lean/Fv256/Spec and lean/Fv256/Proofs must exist')
# 1. import hygiene, with imports parsed by LEAN'S OWN header parser (scripts/LintImports.lean via lint_source.parse_imports): `import A import B`
# on one line, `import all`, comment tricks and `prelude` are seen as the compiler sees them. Spec/ may import only Fv256.Spec.* (and Janus,
# Extracted, Lean, Std, Init), with no modifier; nothing in lean/ may use prelude / import all.
sys.path.insert(0, os.path.join(ROOT, 'scripts'))
import lint_source
spec_files = []
for r, _, fs in os.walk('lean/Fv256/Spec'):
    spec_files += [os.path.join(r, f) for f in fs if f.endswith('.lean')]
nspec = len(spec_files)
for p, mods in sorted(lint_source.parse_imports(sorted(spec_files + ['lean/Fv256/Spec.lean'])).items()):
    if not any(m == 'Init' and not fl for m, fl in mods):
        print('FAIL: %s: `prelude`' % p); fail = 1
    for m, fl in mods:
        if fl and m != 'Init':
            print('FAIL: %s imports %s with modifier `%s`' % (p, m, fl)); fail = 1
        root = m.split('.')[0]
        if root == 'Fv256' and not (m.startswith('Fv256.Spec.') or m == 'Fv256.Spec'):
            print('FAIL: %s imports %s (Spec modules may import only Fv256.Spec.*, Janus, Extracted, Lean)' % (p, m)); fail = 1
        elif root not in lint_source.ALLOWED_ROOTS:
            print('FAIL: %s imports %s (outside Fv256.Spec/Extracted/Janus/Lean/Std/Init)' % (p, m)); fail = 1
# and nothing but Spec/Proofs/ root file lives under lean/Fv256
for e in os.listdir('lean/Fv256'):
    if e not in ('Spec', 'Proofs', 'Spec.lean'):
        print('FAIL: unexpected lean/Fv256/%s (only Spec/, Proofs/ and the umbrella Spec.lean allowed)' % e); fail = 1
if structure_only:
    print('check-spec-closure --structure-only: %s (%d Spec files)' % ('FAILED' if fail else 'OK', nspec))
    sys.exit(fail)
# 2. the survey
if closure is None:
    closure = 'build/spec-closure-check.json'
    r = subprocess.run([sys.executable, 'scripts/spec_survey.py', '--out', closure] + args)
    if r.returncode != 0:
        sys.exit('check-spec-closure: FAIL: survey crashed')
sv = json.load(open(closure))
defs = set(); mods = set(); nthm = 0
for key, v in sorted(sv.items()):
    if 'error' in v:
        print('FAIL: %s: %s' % (key, v['error'][:300])); fail = 1; continue
    if v.get('errors'):
        print('FAIL: %s: elaboration errors in survey: %s' % (key, v['errors'][0][:200])); fail = 1
    for c in v['consts']:
        if any(c['name'].startswith(r + '.') for r in v['roots']):
            continue      # auxiliary constant of the final theorem's own statement (e.g. Witness.nonvacuous.match_1): part of the theorem
        if c['module'].startswith('Fv256.Spec.') or c['module'] == 'Fv256.Spec':
            mods.add(c['module'])
            if c['kind'] != 'thm':
                defs.add(c['name'])
        else:
            print('FAIL: %s: statement depends on %s %s defined in %s (outside Spec/); reached via %s' % (key, c['kind'], c['name'], c['module'], c['parent'])); fail = 1
        if c['kind'] == 'thm':
            nthm += 1
print('check-spec-closure: %d theorem rows surveyed; spec closure = %d modules, %d definitions (Spec/ has %d files); %s'
      % (len(sv), len(mods), len(defs), nspec, 'FAILED' if fail else 'OK'))
if index and not fail:
    with open(index, 'w') as o:
        o.write('# Specification index (generated by scripts/check-spec-closure --index)\n\n%d modules, %d definitions. For every verified theorem, the Spec/ definitions its statement depends on:\n\n' % (len(mods), len(defs)))
        for key, v in sorted(sv.items()):
            names = sorted({c['name'] for c in v['consts'] if c['kind'] != 'thm' and not re.search(r'\.(match_\d+|_f|_proof_\d+|_eq_\d+|proof_\d+)$', c['name'])})
            o.write('## %s\n\n- theorems: %s\n- spec modules: %s\n- definitions: %s\n\n' % (key, ', '.join('`%s`' % r for r in v['roots']),
                    ', '.join(sorted({c['module'] for c in v['consts']})), ', '.join('`%s`' % n for n in names)))
sys.exit(fail)
